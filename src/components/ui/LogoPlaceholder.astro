---
/**
 * Bildflaeche fuer ein Kundenlogo, solange das SVG fehlt (Entwurf:
 * "Logos Gissler & Pass und WEIG Karton als SVG mit Freiraum").
 * Rein dekorativ: der Firmenname steht daneben als Text.
 * TODO: durch <img src=…svg alt=""> ersetzen, sobald die Logos vorliegen.
 */
interface Props {
  label: string;
  shortLabel?: string;
}

const { label, shortLabel = 'Logo' } = Astro.props;
---

<div class="vzp-logo-slot" aria-hidden="true">
  <span class="vzp-desktop-only">{label}</span>
  <span class="vzp-mobile-only">{shortLabel}</span>
</div>

<style>
  .vzp-logo-slot {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 5.5rem;
    block-size: 2.75rem;
    padding: var(--vzp-space-1);
    border: var(--vzp-border-width-100) dashed var(--vzp-color-border-strong);
    background-color: var(--vzp-color-surface-subtle);
    color: var(--vzp-color-text-secondary);
    font-size: var(--vzp-font-size-100);
    font-weight: var(--vzp-font-weight-medium);
    line-height: var(--vzp-line-height-300);
    text-align: center;
  }

  @media (min-width: 48em) {
    .vzp-logo-slot {
      inline-size: 7.5rem;
      block-size: 3.75rem;
    }
  }
</style>
