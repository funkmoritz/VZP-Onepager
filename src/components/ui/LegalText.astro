---
import type { LegalBlock } from '../../data/legal';

/**
 * Rendert einen Block eines Rechtstextes. Inline-Links stehen in den Daten als
 * [Beschriftung](ziel) - ein Mini-Parser ersetzt sie durch <a>, damit die
 * Texte in legal.ts als zusammenhaengende Saetze lesbar bleiben.
 */
interface Props {
  block: LegalBlock;
}

const { block } = Astro.props;

const LINK = /\[([^\]]+)\]\(([^)]+)\)/g;

/** Zerlegt einen Absatz in Text- und Linkteile. */
const parse = (text: string) => {
  const parts: ({ text: string } | { label: string; href: string })[] = [];
  let last = 0;
  for (const match of text.matchAll(LINK)) {
    if (match.index > last) parts.push({ text: text.slice(last, match.index) });
    parts.push({ label: match[1]!, href: match[2]! });
    last = match.index + match[0].length;
  }
  if (last < text.length) parts.push({ text: text.slice(last) });
  return parts;
};

const isExternal = (href: string) => href.startsWith('http');
---

{block.type === 'h3' && <h3 class="vzp-h5 vzp-legal__subheading" set:text={block.text} />}

{block.type === 'p' && (
  <p class="vzp-legal__p">
    {parse(block.text).map((part) =>
      'href' in part ? (
        <a
          class="vzp-link"
          href={part.href}
          target={isExternal(part.href) ? '_blank' : undefined}
          rel={isExternal(part.href) ? 'noopener' : undefined}
        >
          {part.label}
          {isExternal(part.href) && <span class="sr-only"> (neues Fenster)</span>}
        </a>
      ) : (
        part.text
      ),
    )}
  </p>
)}

{block.type === 'ul' && (
  <ul class="vzp-legal__list" role="list">
    {block.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}

{block.type === 'address' && (
  <address class="vzp-legal__address">
    {block.lines.map((line, index) => (
      <>
        {index > 0 && <br />}
        {line}
      </>
    ))}
  </address>
)}

<style>
  .vzp-legal__p,
  .vzp-legal__list,
  .vzp-legal__address {
    max-inline-size: 70ch;
    font-size: var(--vzp-font-size-400);
    line-height: var(--vzp-line-height-600);
    color: var(--vzp-color-text-primary);
  }

  .vzp-legal__subheading {
    margin-block-start: var(--vzp-space-6);
  }

  .vzp-legal__list {
    display: grid;
    gap: var(--vzp-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vzp-legal__list > li {
    position: relative;
    padding-inline-start: var(--vzp-space-4);
  }

  .vzp-legal__list > li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.6em;
    inset-inline-start: 0;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    background-color: var(--vzp-color-border-brand);
  }

  .vzp-legal__address {
    font-style: normal;
    font-weight: var(--vzp-font-weight-semibold);
  }
</style>
