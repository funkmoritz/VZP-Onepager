---
import { Picture } from 'astro:assets';
import logoGisslerPass from '../../assets/images/logo-gissler-pass.png';
import logoWeigKarton from '../../assets/images/logo-weig-karton.png';
import { REFERENCES } from '../../data/content';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

/*
 * Referenzen: zwei Zitate von Gesellschaftern (Zitat/Callout mit blauer Kante).
 * Die Zitate stehen woertlich wie auf vzp-online.de und werden mobil nicht
 * gekuerzt.
 */
const logos: Record<string, ImageMetadata> = {
  'logo-gissler-pass': logoGisslerPass,
  'logo-weig-karton': logoWeigKarton,
};
---

<Section id="referenzen" labelledby="referenzen-titel" tone="surface">
  <SectionHeader id="referenzen-titel" overline={REFERENCES.overline} title={REFERENCES.title}>
    <p class="vzp-references__lead vzp-desktop-only">{REFERENCES.lead}</p>
  </SectionHeader>

  <ul class="vzp-references" role="list">
    {REFERENCES.items.map((item) => (
      <li class="vzp-reference">
        <figure class="vzp-reference__figure">
          <blockquote class="vzp-reference__quote">
            <p>„{item.quote}“</p>
          </blockquote>
          <figcaption class="vzp-reference__source">
            {/* Der Firmenname steht als Text daneben - das Logo ist deshalb
                dekorativ und bekommt keinen Alternativtext (WCAG 1.1.1). */}
            <Picture
              src={logos[item.logo]!}
              alt=""
              formats={['avif', 'webp']}
              widths={[160, 320]}
              sizes="160px"
              loading="lazy"
              class="vzp-reference__logo"
            />
            <span class="vzp-reference__company">{item.company}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</Section>

<style>
  .vzp-references__lead {
    font-size: var(--vzp-font-size-300);
    color: var(--vzp-color-text-secondary);
  }

  .vzp-references {
    display: grid;
    gap: var(--vzp-space-4);
    margin: var(--vzp-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .vzp-reference {
    display: flex;
  }

  .vzp-reference__figure {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    margin: 0;
    padding: var(--vzp-space-6) var(--vzp-space-5) var(--vzp-space-5);
    border: var(--vzp-border-width-100) solid var(--vzp-color-border-default);
    border-block-start: var(--vzp-border-width-300) solid var(--vzp-color-border-brand);
    background-color: var(--vzp-color-background-default);
  }

  /* Die Originalzitate sind lang - eine Stufe kleiner als im Entwurf, damit
     sie als Block lesbar bleiben. */
  .vzp-reference__quote {
    margin: 0 0 var(--vzp-space-5);
    font-family: var(--vzp-typography-heading-family);
    font-size: var(--vzp-font-size-400);
    line-height: var(--vzp-line-height-600);
    color: var(--vzp-color-text-primary);
    text-wrap: pretty;
  }

  .vzp-reference__source {
    display: flex;
    gap: var(--vzp-space-5);
    align-items: center;
    margin-block-start: auto;
    padding-block-start: var(--vzp-space-5);
    border-block-start: var(--vzp-border-width-100) solid var(--vzp-color-border-default);
  }

  .vzp-reference__logo {
    flex-shrink: 0;
    display: block;
    inline-size: auto;
    block-size: 2.25rem;
    max-inline-size: 10rem;
    object-fit: contain;
    object-position: left center;
  }

  .vzp-reference__company {
    font-size: var(--vzp-font-size-300);
    font-weight: var(--vzp-font-weight-semibold);
    line-height: var(--vzp-line-height-400);
    color: var(--vzp-color-text-primary);
  }

  @media (min-width: 48em) {
    .vzp-references {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--vzp-space-8);
      margin-block-start: var(--vzp-space-16);
    }

    .vzp-reference__figure {
      padding: var(--vzp-space-10);
    }

    .vzp-reference__quote {
      margin-block-end: var(--vzp-space-8);
      font-size: var(--vzp-font-size-450);
      line-height: var(--vzp-line-height-600);
    }

    .vzp-reference__source {
      padding-block-start: var(--vzp-space-6);
    }

    .vzp-reference__logo {
      block-size: 2.625rem;
    }

    .vzp-reference__company {
      font-size: var(--vzp-font-size-450);
    }
  }
</style>
