---
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Events from '../components/sections/Events.astro';
import Hero from '../components/sections/Hero.astro';
import News from '../components/sections/News.astro';
import Positioning from '../components/sections/Positioning.astro';
import References from '../components/sections/References.astro';
import Services from '../components/sections/Services.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';

/*
 * Informationsarchitektur laut Screendesign (Abschnitt 4):
 * Hero -> Positionierungsband -> Leistungen -> Referenzen -> Ueber uns ->
 * Events & Webinare -> Aktuelles -> Kontakt -> Footer (im Layout).
 * Die Sektions-IDs entsprechen NAV_ITEMS in src/consts.ts.
 */
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero />
  <Positioning />
  <Services />
  <References />
  <About />
  <Events />
  <News />
  <Contact />
</Layout>
