---
import '../styles/global.css';
import notoSansLatin from '../assets/fonts/noto-sans-latin-wght-normal.woff2?url';
import notoSerifLatin from '../assets/fonts/noto-serif-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTENT_ID, SITE_LANG, SITE_LOCALE, SITE_NAME, SITE_OG_IMAGE } from '../consts';
import { organization, webPage, webSite } from '../data/schema';

interface Props {
  /** Inhalt des <title>-Tags. */
  title: string;
  /** Meta-Description, ca. 150–160 Zeichen. */
  description: string;
  /** Pfad oder absolute URL zum Social-Preview-Bild. */
  image?: string;
  /** Setzt die Seite auf noindex, z. B. für Vorschau-Deployments. */
  noindex?: boolean;
  /** Zusätzliche JSON-LD-Knoten für diese Seite (siehe data/schema.ts). */
  schemas?: Record<string, unknown>[];
}

const { title, description, image = SITE_OG_IMAGE, noindex = false, schemas = [] } = Astro.props;

// Auf Unterseiten (Impressum etc.) muessen die Sprungmarken der Navigation
// auf die Startseite zeigen.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const anchorBase = isHome ? '' : '/';

// `Astro.site` stammt aus astro.config.mjs. Der Fallback greift nur, falls
// dort keine `site` gesetzt ist – dann bleiben die URLs relativ zur Anfrage.
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base);
const socialImageURL = new URL(image, base);

// Ein Graph pro Seite: Unternehmen, Website, diese Seite, dann die
// seitenspezifischen Knoten (Events, Personen, FAQ ... aus data/schema.ts).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(base),
    webSite(base),
    webPage(base, canonicalURL, title, description),
    ...schemas,
  ],
};
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {/* `follow` statt `nofollow`: die Seite soll nicht in den Index, ihre
         Links (Impressum, Datenschutz, Startseite) sollen aber weiterhin
         Signale weitergeben. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FDF9F8" />

    {/* Selbst gehostete Schriften (fonts.css). Nur die latin-Teilmengen
         vorladen: sie decken den deutschen Text vollstaendig ab. */}
    <link rel="preload" href={notoSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoSerifLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script is:inline>
      // Markiert "JS ist aktiv", noch vor dem ersten Paint. Ohne dieses Flag
      // liefert das CSS die aufgeklappte Navigation aus statt ein Panel, das
      // sich ohne JS nie oeffnen liesse (Progressive Enhancement).
      document.documentElement.dataset.js = '';
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <!-- Für seitenspezifische Tags: Fonts, JSON-LD, Analytics-Snippets ... -->
    <slot name="head" />
  </head>

  <body>
    <script>
      import '../scripts/disclosure';
    </script>
    {/* Muss das erste fokussierbare Element der Seite sein (WCAG 2.4.1 / BFSG).
         Bei einer sticky Kopfzeile ist der Skip-Link Pflicht, nicht Kür. */}
    <a class="skip-link" href={`#${CONTENT_ID}`}>
      Zum Inhalt springen
    </a>

    <Header anchorBase={anchorBase} />

    {/* tabindex="-1": ohne das verschieben einige Browser nach dem Sprung nur
         die Scrollposition, der Fokus bliebe in der Kopfzeile haengen. */}
    <main id={CONTENT_ID} tabindex="-1">
      <slot />
    </main>

    {/* Ausserhalb von <main>: eigene contentinfo-Landmark. */}
    <Footer />
  </body>
</html>

<style>
  /*
   * Nicht display:none und nicht visibility:hidden - beides nimmt den Link aus
   * der Tab-Reihenfolge und macht ihn damit nutzlos. Stattdessen aus dem
   * Sichtfeld schieben.
   */
  .skip-link {
    position: fixed;
    inset-block-start: var(--vzp-spacing-component-sm);
    inset-inline-start: var(--vzp-spacing-component-sm);
    z-index: var(--z-skip-link);
    translate: 0 calc(-100% - var(--vzp-spacing-component-sm) * 2);

    display: inline-flex;
    align-items: center;
    min-block-size: var(--vzp-button-height-md);
    padding-inline: var(--vzp-button-padding-x-md);

    border-radius: var(--vzp-button-radius);
    background-color: var(--vzp-button-primary-background-default);
    color: var(--vzp-button-primary-foreground);
    font-size: var(--vzp-button-label-size);
    font-weight: var(--vzp-button-label-weight);
    text-decoration: none;

    transition: translate var(--vzp-motion-state-change) var(--vzp-easing-entrance);
  }

  /* :focus statt :focus-visible - ausserhalb des Sichtfelds ist der Link nicht
     anklickbar, er kann den Fokus also ohnehin nur per Tastatur bekommen. */
  .skip-link:focus {
    translate: none;
  }
</style>
